NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://faatora_app:faatora_app@localhost:5432/faatora
MIGRATION_DATABASE_URL=postgres://faatora:faatora@localhost:5432/faatora
AWS_REGION=me-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Firm-console subscription billing. Flip BILLING_PROVIDER between
# 'stripe' (default, UAE Meydan merchant of record) and 'paymob' (Oman
# direct; requires sandbox onboarding, see
# docs/research/paymob-uat-integration-plan.md).
BILLING_PROVIDER=stripe

# Stripe. Required when BILLING_PROVIDER=stripe in production; dev/test
# may leave them blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paymob. Required when BILLING_PROVIDER=paymob in production; dev/test
# may leave them blank. Dashboard: Settings > Developers > API Keys
# (in test mode) at https://oman.paymob.com. HMAC secret: Settings >
# Account Info > HMAC. Integration ID: Settings > Payment Integrations
# (card/MOTO integration id for subscriptions).
#
# Under the Intention + Unified Checkout flow the adapter uses:
#   - PAYMOB_SECRET_KEY on the Intention API ("Authorization: Token sk_...")
#   - PAYMOB_PUBLIC_KEY on the Unified Checkout redirect URL
#   - PAYMOB_API_KEY still needed for the Subscription-Plan admin endpoints
#     (Bearer token via /api/auth/tokens)
# The legacy PAYMOB_IFRAME_ID is kept so the adapter boots but is unused
# by the new flow; remove in a later wave.
PAYMOB_API_KEY=                   # sandbox api key (long base64-ish string, same for test/live)
PAYMOB_SECRET_KEY=sk_test_xxx     # sandbox secret key (sk_test_... / sk_live_...)
PAYMOB_PUBLIC_KEY=pk_test_xxx     # sandbox public key (pk_test_... / pk_live_...)
PAYMOB_HMAC_SECRET=               # sandbox hmac secret
PAYMOB_INTEGRATION_ID=            # sandbox MOTO integration id (e.g. 4567890)
PAYMOB_IFRAME_ID=                 # legacy, unused by Unified Checkout (any non-empty value is fine)
# Optional overrides.
#   PAYMOB_BASE_URL default:     https://oman.paymob.com        (API host)
#   PAYMOB_CHECKOUT_URL default: https://om.checkout.paymob.com (Unified Checkout UI host)
# Note the API host and Checkout host differ; see
# docs/research/paymob-intention-api-refactor-design.md section 3.
PAYMOB_BASE_URL=
PAYMOB_CHECKOUT_URL=
PAYMOB_PORTAL_RETURN_URL=

# Sentry error tracking.
# When SENTRY_DSN is unset the SDK is not initialised — local dev needs
# nothing here. Ahmed pulls the DSNs from AWS Secrets Manager via the
# ECS task definition (api) and Vercel project env (web). See
# docs/observability-setup.md.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Web app Sentry (used by apps/web; prefixed VITE_ so Vite inlines it).
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry source-map upload, consumed by @sentry/vite-plugin at build
# time. Only needed in CI; local builds leave them blank and the
# plugin is a no-op.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PagerDuty.
# PAGERDUTY_WEBHOOK_SECRET: HMAC SHA256 shared secret used by the
#   /api/webhooks/pagerduty controller to verify incoming PagerDuty
#   webhook signatures. Required in production (controller 503s
#   without it). See docs/observability-setup.md.
# PAGERDUTY_ROUTING_KEY: integration key for the PagerDuty Events API
#   v2 service the API posts alerts to. Leave blank to disable the
#   outbound client; trigger()/acknowledge()/resolve() throw if called
#   without one.
PAGERDUTY_WEBHOOK_SECRET=
PAGERDUTY_ROUTING_KEY=
